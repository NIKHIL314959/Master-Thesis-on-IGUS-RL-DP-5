<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="Info_Bar_eventbinding" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Bindings>
		<EventBinding id="Info_Bar.Image1.Click">
			<Source contentRefId="Info_Bar" widgetRefId="Image1" xsi:type="widgets.brease.Image.Event" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.OpenDialog" dialogId="Dia_Login"  headerText="Please Login" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="Info_Bar.LoginInfo1.Click">
			<Source contentRefId="Info_Bar" widgetRefId="LoginInfo1" xsi:type="widgets.brease.LoginInfo.Event" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.OpenDialog" dialogId="Dia_Login"  headerText="Please Login" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		
		<EventBinding>
			<Source xsi:type="session.Event" refId="::SYSTEM:clientInfo.userId" event="ValueChanged" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.CloseDialog" dialogId="Dia_Login" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		
		<EventBinding id="Info_Bar.Image5.Click">
			<Source contentRefId="Info_Bar" widgetRefId="Image5" xsi:type="widgets.brease.Image.Event" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.Navigate" pageId="ERROR_Page" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
		<EventBinding id="Info_Bar.Image2.Click">
			<Source contentRefId="Info_Bar" widgetRefId="Image2" xsi:type="widgets.brease.Image.Event" event="Click" />
			<EventHandler>
				<Action>
					<Target xsi:type="clientSystem.Action">
						<Method xsi:type="clientSystem.Action.Navigate" pageId="ERROR_Page" />
					</Target>
				</Action>
			</EventHandler>
		</EventBinding>
	</Bindings>
</EventBindingSet>
