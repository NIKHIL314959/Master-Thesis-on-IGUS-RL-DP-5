VAR
	gTargetX : LREAL := 0; (*Target TCP X position [mm] from MATLAB*)
	gTargetY : LREAL := 0; (*Target TCP Y position [mm] from MATLAB*)
	gTargetZ : LREAL := 0; (*Target TCP Z position [mm] from MATLAB*)
	gTargetB : LREAL := 0; (*Target TCP B orientation in deg*)
	gTargetC : LREAL := 0; (*Target TCP C orientation in deg*)
	gCmd_MoveLinear : BOOL := FALSE; (*Trigger straight line TCP move*)
	gCmd_Stop : BOOL := FALSE; (*Stop current motion*)
	gCmd_ErrorReset : BOOL := FALSE; (*Reset robot error state*)
	gCmd_MoveDirect : BOOL := FALSE; (*Trigger point to point TCP move*)
	gCmd_JogJoint : BOOL := FALSE; (*Trigger single joint jog step*)
	gJogJointIndex : INT := 0; (*Index of joint to jog*)
	gJogJointStep : LREAL := 0.0; (*Jog step size [deg]*)
	gStatus_Ready : BOOL := FALSE; (*Robot ready to accept commands*)
	gStatus_Moving : BOOL := FALSE; (*Motion currently active*)
	gStatus_InPosition : BOOL := FALSE; (*TCP reached target*)
	gStatus_Error : BOOL := FALSE; (*Error flag*)
	gStatus_ErrorID : DINT := 0; (*Active error code*)
	gStatus_Homed : BOOL := FALSE; (*Robot has been homed*)
	gStatus_PowerOn : BOOL := FALSE; (*Drives powered on*)
	gActual_X : LREAL := 0; (*Live TCP X position [mm]*)
	gActual_Y : LREAL := 0; (*Live TCP Y position [mm]*)
	gActual_Z : LREAL := 0; (*Live TCP Z position [mm]*)
	gActual_B : LREAL := 0; (*Live TCP B orientation [deg]*)
	gActual_C : LREAL := 0; (*Live TCP C orientation [deg]*)
	gActual_Q1 : LREAL := 0; (*Live joint angle Q1 [deg]*)
	gActual_Q2 : LREAL := 0; (*Live joint angle Q2 [deg]*)
	gActual_Q3 : LREAL := 0; (*Live joint angle Q3 [deg]*)
	gActual_Q4 : LREAL := 0; (*Live joint angle Q4 [deg]*)
	gActual_Q5 : LREAL := 0; (*Live joint angle Q5 [deg]*)
	gParam_Velocity : REAL := 10; (*Path velocity limit [mm/s]*)
	gParam_Acceleration : REAL := 50; (*Path acceleration limit [mm/s²]*)
	gParam_Override : REAL := 100; (*Speed override [%]*)
	gEStop_Active : BOOL := FALSE; (*Emergency stop pressed*)
	gEStop_OK : BOOL := TRUE; (*E-stop circuit healthy*)
	RoboParameters : MpRoboArm5AxisParType; (*Parameters for MpRoboArm5Axis*)
	MpRoboArm5Axis_0 : MpRoboArm5Axis; (*Robot motion function block instance*)
	fbMpAxisBasic : ARRAY[0..4] OF MpAxisBasic; (*Single-axis FBs for Q1-Q5*)
	ParAxis : ARRAY[0..4] OF MpAxisBasicParType; (*Per-Axis parameters for Q1-Q5*)
	gAngleOffset_Q1 : LREAL := 0; (*Home offset for Q1 [deg]*)
	gAngleOffset_Q2 : LREAL := -10; (*Home offset for Q2 [deg]*)
	gAngleOffset_Q3 : LREAL := 10; (*Home offset for Q3 [deg]*)
	gAngleOffset_Q4 : LREAL := -60; (*Home offset for Q4 [deg]*)
	gAngleOffset_Q5 : LREAL := -10; (*Home offset for Q1 [deg]*)
	gZeroedAngle_Q1 : LREAL; (*Q1 angle relative to home [deg]*)
	gZeroedAngle_Q2 : LREAL; (*Q2 angle relative to home [deg]*)
	gZeroedAngle_Q3 : LREAL; (*Q3 angle relative to home [deg]*)
	gZeroedAngle_Q4 : LREAL; (*Q4 angle relative to home [deg]*)
	gZeroedAngle_Q5 : LREAL; (*Q5 angle relative to home [deg]*)
	gPickX : LREAL := 0; (*Taught pick position X [mm]*)
	gPickY : LREAL := 0; (*Taught pick position Y [mm]*)
	gPickZ : LREAL := 0; (*Taught pick position Z [mm]*)
	gPickB : LREAL := 0; (*Taught pick orientation B [deg]*)
	gPickC : LREAL := 0; (*Taught pick orientation C [deg]*)
	gPlaceX : LREAL := 0; (*Taught place position X [mm]*)
	gPlaceY : LREAL := 0; (*Taught place position Y [mm]*)
	gPlaceZ : LREAL := 0; (*Taught place position Z [mm]*)
	gPlaceB : LREAL := 0; (*Taught place orientation B [deg]*)
	gPlaceC : LREAL := 0; (*Taught place orientation C [deg]*)
	gHomeX : LREAL := 0; (*Taught home position X [mm]*)
	gHomeY : LREAL := 0; (*Taught home position Y [mm]*)
	gHomeZ : LREAL := 0; (*Taught home position Z [mm]*)
	gHomeB : LREAL := 0; (*Taught home orientation B [deg]*)
	gHomeC : LREAL := 0; (*Taught home orientation C [deg]*)
	PP_OFFSET : LREAL := 80; (*Safe approach height above pick/place [mm]*)
	gCmd_TeachPick : BOOL := FALSE; (*Safe current TCP as pick position*)
	gCmd_TeachPlace : BOOL := FALSE; (*Safe current TCP as place position*)
	gCmd_TeachHome : BOOL := FALSE; (*Safe current TCP as home position*)
	SM_Module_TriggerVars : VarsHomingSwitchTrigger_typ; (*Homing switch trigger signals*)
	gCmd_Home : BOOL; (*Trigger homing sequence from MATLAB HMI*)
	gStatus_Homing : BOOL; (*TRUE while homing is in progress*)
END_VAR
