VAR
	initDone : BOOL := FALSE; (*First-Cycle initialization*)
	i : INT; (*loop index*)
	allAxesHomed : BOOL; (*All axes homed*)
	allAxesPowered : BOOL; (*All axes powered*)
	gGripperOpen : BOOL; (*Gripper open*)
	gGripperClose : BOOL; (*Gripper close*)
	pickPlaceStep : INT := 0; (*Current step in the pick and place state machine*)
	gCmd_PickPlace : BOOL := FALSE; (*Start pick and place sequence*)
	ppGripperDelay : INT := 0; (*Cycle counter for gripper settle delay*)
	trigMoveLinear : r_trig; (*Rising-edge trigger for linear move*)
	trigStop : r_trig; (*Rising-edge trigger for stop*)
	trigErrorReset : r_trig; (*Rising-edge trigger for error reset*)
	trigMoveDirect : r_trig; (*Rising-edge trigger for direct move*)
	trigJogJoint : r_trig; (*Rising-edge trigger for joint jog*)
	trigTeachPick : r_trig; (*Rising-edge trigger to teach pick*)
	trigTeachPlace : r_trig; (*Rising-edge trigger to teach place*)
	trigTeachHome : r_trig; (*Rising-edge trigger to teach home*)
	trigHome : r_trig; (*Rising-edge trigger for home*)
	cStandHeight : REAL := 200; (*Stand Height*)
END_VAR
